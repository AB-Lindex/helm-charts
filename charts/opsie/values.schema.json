{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "replicaCount": {
      "oneOf": [
        { "type": "string", "maxLength": 0 },
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "part": {
      "type": "object",
      "properties": {
        "replicaCount": { "$ref": "#/definitions/replicaCount" },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "topologySpreadConstraints": { "type": "array" },
        "annotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "extraEnv": { "type": "array" }
      }
    }
  },
  "properties": {
    "fullnameOverride": { "type": "string" },
    "nameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": ["string", "number"] },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array" }
      }
    },
    "topology": {
      "type": "string",
      "enum": ["all-in-one", "split-ingest", "split-all"]
    },
    "topologySpread": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "constraints": { "type": "array" }
      }
    },
    "parts": {
      "type": "object",
      "properties": {
        "all": { "$ref": "#/definitions/part" },
        "ingest": { "$ref": "#/definitions/part" },
        "processor": { "$ref": "#/definitions/part" },
        "app": { "$ref": "#/definitions/part" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "enum": ["auto", true, false] }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["mssql", "postgres"] },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string" },
        "migrate": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "type": "string", "enum": ["hook", "initContainer", "none"] },
            "dryRun": { "type": "boolean" },
            "backoffLimit": { "type": "integer", "minimum": 0 },
            "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
            "ttlSecondsAfterFinished": { "type": ["integer", "null"], "minimum": 0 },
            "initContainerParts": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "valkey": {
      "type": "object",
      "additionalProperties": true
    },
    "valkeySentinel": {
      "type": "object",
      "additionalProperties": true
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["standalone", "sentinel"] },
        "addr": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string" },
        "existingSecretSentinelKey": { "type": "string" }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "sessionCacheTtl": { "type": "string" },
        "sessionCacheStaleGrace": { "type": "string" }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "tls": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["none", "proxy", "native"] },
        "existingSecret": { "type": "string" },
        "mountPath": { "type": "string" },
        "httpsRedirect": { "type": "boolean" },
        "hstsMaxAge": { "type": ["string", "integer"] }
      }
    },
    "internal": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environmentName": { "type": "string", "maxLength": 16 },
        "environmentColor": { "type": "string", "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}))?$" },
        "companyLogoUrl": { "type": "string" }
      }
    },
    "rego": {
      "type": "object",
      "properties": {
        "helpers": {
          "type": "object",
          "properties": {
            "existingConfigMap": { "type": "string" },
            "mountPath": { "type": "string", "pattern": "^/" }
          }
        },
        "evalTimeout": { "type": "string" },
        "cacheBytes": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9]*$" },
            { "type": "integer", "minimum": 1 }
          ]
        }
      }
    },
    "email": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "domain": { "type": "string" },
        "existingSecret": { "type": "string" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": ["string", "number"] },
            "pullPolicy": { "type": "string", "enum": ["", "Always", "IfNotPresent", "Never"] }
          }
        },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "logLevel": { "type": "string", "enum": ["trace", "debug", "info", "warn", "error"] },
        "forwardTimeout": { "type": "string" },
        "routes": {
          "type": "object",
          "properties": {
            "pollInterval": { "type": "string" },
            "maxAge": { "type": "string" }
          }
        },
        "smtp": {
          "type": "object",
          "properties": {
            "domain": { "type": "string" },
            "acceptDomains": { "type": "array", "items": { "type": "string" } },
            "maxMessageBytes": { "type": ["string", "integer"] },
            "rcptFailMax": { "type": ["string", "integer"] },
            "rcptFailWindow": { "type": "string" }
          }
        },
        "blob": {
          "type": "object",
          "properties": {
            "provider": { "type": "string", "enum": ["azure", "s3", "filesystem"] },
            "existingSecret": { "type": "string" },
            "azure": {
              "type": "object",
              "properties": {
                "container": { "type": "string" },
                "auth": { "type": "string", "enum": ["workload-identity", "connection-string", "sas"] },
                "accountUrl": { "type": "string" }
              }
            },
            "s3": {
              "type": "object",
              "properties": {
                "bucket": { "type": "string" },
                "region": { "type": "string" },
                "endpoint": { "type": "string" },
                "pathStyle": { "type": "boolean" }
              }
            },
            "filesystem": {
              "type": "object",
              "properties": {
                "existingClaim": { "type": "string" }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "smtp": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["LoadBalancer", "NodePort", "ClusterIP"] },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "externalTrafficPolicy": { "type": "string", "enum": ["Local", "Cluster"] },
                "loadBalancerIP": { "type": "string" },
                "loadBalancerSourceRanges": { "type": "array" },
                "annotations": { "type": "object" }
              }
            },
            "attachments": {
              "type": "object",
              "properties": {
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            },
            "metrics": {
              "type": "object",
              "properties": {
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "metricsPeers": { "type": "array" },
            "egress": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "emailEgress": {
              "type": "object",
              "properties": {
                "blobTo": { "type": "array" },
                "blobPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "entraTo": { "type": "array" }
              }
            }
          }
        },
        "podLabels": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "extraEnv": { "type": "array" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "topologySpreadConstraints": { "type": "array" }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "sse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxConnectionsPerUser": {
          "oneOf": [
            { "type": "string", "maxLength": 0 },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "maxConnections": {
          "oneOf": [
            { "type": "string", "maxLength": 0 },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "httpRoute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeouts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "request": { "type": "string" },
                "backendRequest": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "alertEvents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "shareLinks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "publicBaseUrl": { "type": "string", "pattern": "^(https?://[^/?#\\s]+/?)?$" },
        "lifetime": { "type": "string" }
      }
    },
    "ingresses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "httpRoutes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "parentRefs"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "parentRefs": { "type": "array", "minItems": 1 }
        }
      }
    },
    "extraObjects": { "type": "array" }
  }
}
